{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "out/**", ".vite/**"],
      "passThroughEnv": ["RESEND_API_KEY", "RESEND_AUDIENCE_ID", "RESEND_TEMPLATE_ID"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "cache": false
    },
    "desktop": {
      "cache": false,
      "persistent": true
    },
    "web": {
      "cache": false,
      "persistent": true
    },
    "community": {
      "cache": false,
      "persistent": true
    }
  }
}
