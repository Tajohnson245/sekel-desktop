{
  "name": "@sekel/desktop",
  "version": "1.8.0",
  "description": "Anki but better",
  "homepage": "https://github.com/Tajohnson245/sekel#readme",
  "bugs": {
    "url": "https://github.com/Tajohnson245/sekel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tajohnson245/sekel.git"
  },
  "license": "MIT",
  "author": "BYTEFLOW LLC",
  "type": "commonjs",
  "main": "dist/main/main.js",
  "scripts": {
    "postinstall": "node scripts/rebuild-native.js",
    "dev": "node scripts/electron-dev.js",
    "desktop": "node scripts/electron-dev.js",
    "start": "node scripts/electron-dev.js",
    "dev:renderer": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "package": "node -e \"delete process.env.ELECTRON_RUN_AS_NODE;require('child_process').execSync('electron-vite build && electron-forge package',{stdio:'inherit'})\"",
    "make": "node -e \"delete process.env.ELECTRON_RUN_AS_NODE;const arch=process.env.FORGE_ARCH?(' --arch='+process.env.FORGE_ARCH):'';require('child_process').execSync('electron-vite build && electron-forge make'+arch,{stdio:'inherit'})\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "publish": "node -e \"delete process.env.ELECTRON_RUN_AS_NODE;const arch=process.env.FORGE_ARCH?(' --arch='+process.env.FORGE_ARCH):'';require('child_process').execSync('electron-vite build && electron-forge publish'+arch,{stdio:'inherit'})\"",
    "publish:s3": "node -e \"delete process.env.ELECTRON_RUN_AS_NODE;const arch=process.env.FORGE_ARCH?(' --arch='+process.env.FORGE_ARCH):'';require('child_process').execSync('electron-vite build && electron-forge publish --target @electron-forge/publisher-s3'+arch,{stdio:'inherit'})\"",
    "publish:gh": "node -e \"delete process.env.ELECTRON_RUN_AS_NODE;const arch=process.env.FORGE_ARCH?(' --arch='+process.env.FORGE_ARCH):'';require('child_process').execSync('electron-vite build && electron-forge publish --target @electron-forge/publisher-github'+arch,{stdio:'inherit'})\"",
    "rebuild:electron": "npx @electron/rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "db:push": "npx supabase db push",
    "db:reset": "npx supabase db reset",
    "db:migrate": "npx supabase migration up"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron-forge/publisher-s3": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.10.12",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "5.1.3",
    "@vitest/coverage-v8": "^4.1.0",
    "cross-env": "^10.1.0",
    "electron": "^40.8.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@sekel/components": "*",
    "@sekel/db": "*",
    "@sekel/observability": "*",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-query": "^5.90.20",
    "better-sqlite3": "^12.6.2",
    "dompurify": "^3.3.3",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.7.3",
    "fast-xml-parser": "^5.3.5",
    "file-type": "^22.0.0",
    "i18next": "^25.8.5",
    "i18next-browser-languagedetector": "^8.2.0",
    "isomorphic-dompurify": "^3.7.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.11.0",
    "openai": "^6.18.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "react-quill-new": "^3.8.3",
    "react-router-dom": "^7.13.2",
    "recharts": "^2.15.4",
    "ts-fsrs": "^5.2.3",
    "update-electron-app": "^3.1.2",
    "xlsx": "^0.18.5",
    "yauzl": "^2.10.0",
    "youtube-transcript": "1.2.1",
    "zustand": "^5.0.11"
  }
}
